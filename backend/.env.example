# Copy this file to .env and fill in your own values. Never commit the real .env.

# Required — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Optional — model overrides
LINK_MODEL=gpt-4o-mini
BROCHURE_MODEL=gpt-4o-mini

# Optional — comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173